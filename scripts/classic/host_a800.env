# A800-SXM(10.10.252.11)宿主档案 —— 唯一允许出现 A800 宿主字面量的地方。
# 消费方:launch_classic.sh / watchdog_single.sh(source 本文件后一切宿主无关)。
export TRACE_HOST=a800
export TRACE_TREE=/fs/fast/u2021000902/wushang/workspace/TRACE-OPD-TERM
export TRACE_ENV_ENTRY=/fs/fast/u2021000902/wushang/workspace/TRACE-OPD-PGS/env_pgs_sglang_a800.sh
export TRACE_PYX=/fs/fast/u2021000902/wushang/workspace/TRACE-OPD/env_sglang_train/bin/python
export TRACE_MODELS=/fs/fast/u2021000902/wushang/model/Qwen
export TRACE_DATA=/fs/fast/u2021000902/wushang/data/classic
# ALFWorld 资产(yaml 经 ${} 插值直接消费)
export ALFWORLD_DATA=/fs/fast/u2021000902/wushang/workspace/data/alfworld_data
