export TRACE_TREE=/data4/wushang/classic_tree
export TRACE_ENV_ENTRY=/data4/ws/PGS/env_q35_162.sh
export TRACE_PYX=/data4/ws/PGS/env_sglang_train_q35/bin/python
export TRACE_MODELS=/data4/zxx/Open_Source_Models
export TRACE_DATA=/data4/wushang
