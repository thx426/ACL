# 162(10.77.110.162)宿主档案 —— 唯一允许出现 162 宿主字面量的地方。
# 训练栈:唯一验证过 verl 训练的 env_sglang_train_q35(2026-08-23 WS7B 全链绿)。
# 35B researcher 端点无需配置:yaml 统一 127.0.0.1:8880-8882,162 经 A800
# 反向隧道同地址即达(隧道守护 = A800 ~/tunnel_guard.sh)。
export TRACE_HOST=162
export TRACE_TREE=/data4/wushang/classic_tree
export TRACE_ENV_ENTRY=/data4/ws/PGS/env_q35_162.sh
export TRACE_PYX=/data4/ws/PGS/env_sglang_train_q35/bin/python
# 2026-08-26 切到自有目录:/data4/zxx/ 是他人目录(不可写、只有 7B);/data3 下 3B/7B 齐,
# 7B 首分片 sha256 a1333e62… 与 zxx 副本逐字节同、3B 与 A800 同。WS7B(已完跑)用的是 zxx
# 路径,其指纹 f2bb626e6f2d 含该字符串——该 run 已结束,不再 resume,无冲突。
export TRACE_MODELS=/data3/wushang/model/Qwen
export TRACE_DATA=/data4/wushang
# ALFWorld 资产(2026-08-26 落地):数据 2.1G/18,412 文件由 A800 tar-over-ssh 传入
# (逐项校验一致);worker venv = conda -p 建的 py3.10.20 + alfworld 0.4.2,
# 与 A800 侧逐包同版本(alfworld 0.4.2 / jericho 3.3.1 / numpy 2.2.6)。
# 真实 episode 冒烟已过(reset+2 步,valid_seen 任务正常返回 won/done)。
# ⚠ conda 建环境须 --override-channels(共用 .condarc 的 msys2 channel 已 404)。
export ALFWORLD_DATA=/data4/wushang/alfworld_data
export ALFWORLD_WORKER_PYTHON=/data4/wushang/alfworld-venv/bin/python

# ★ 2026-08-26 SQA7B 发车事故:162 的 sglang 0.5.10 对 rollout_max_num_batched_tokens=32768
# 的配置自动启用 piecewise CUDA graph,其 warmup_compile 在本机四卡上一致抛
# `CUDA error: an illegal memory access`(两次尝试同点同错);WS7B(8192)在同 env 下
# 未崩(sglang 的 16 条自动禁用规则均不涉 token 数,故只能断言 32768 是触发差异)。关掉该组件只影响推理引擎的 prefill 编译优化,不改采样分布、不进指纹。
# verl 把 engine_kwargs.sglang.* 原样透传 ServerArgs(async_sglang_server.py `**engine_kwargs`)。
export TRACE_VERL_EXTRA_OVERRIDES="+actor_rollout_ref.rollout.engine_kwargs.sglang.disable_piecewise_cuda_graph=true"
